# Copy this file to .env.production on the EC2 instance. Never commit the real file.
POSTGRES_DB=districall
POSTGRES_USER=districall
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-different-long-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-another-different-long-random-secret

# Public HTTPS domain served by Caddy.
CORS_ORIGINS=https://talkocrm.com,https://www.talkocrm.com,https://crm.kelpshealthcare.com
PUBLIC_BASE_URL=https://talkocrm.com

# Private S3 bucket used for organization logos. Keep the bucket private; the
# backend serves short-lived signed download URLs to authenticated workspaces.
S3_BUCKET=replace-with-your-private-logo-bucket
S3_REGION=ap-south-1
# Leave blank when using AWS S3. Set this only for an S3-compatible provider.
S3_ENDPOINT_URL=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30
INTEGRATION_POLL_INTERVAL_SECONDS=300
