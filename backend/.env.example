DATABASE_URL=postgresql+asyncpg://districall:districall@localhost:5433/districall
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Encrypts integration credentials (IndiaMART/JustDial keys) at rest.
# Falls back to JWT_SECRET if blank. Set a distinct long random value in production.
INTEGRATION_ENCRYPTION_KEY=
# Public URL of this API — used to build the webhook address shown in the UI.
# In production this must be the internet-reachable https URL, or JustDial cannot reach you.
PUBLIC_BASE_URL=http://localhost:8000
# How often to poll pull-based providers (IndiaMART). 0 disables the poller.
INTEGRATION_POLL_INTERVAL_SECONDS=300

# Attendance automatically closes any forgotten check-in at midnight in this
# timezone. Use an IANA timezone name.
ATTENDANCE_TIMEZONE=Asia/Kolkata

# Optional local S3-compatible storage for organization logos. Leave blank to
# keep logo uploads disabled locally; production should set S3_BUCKET and rely
# on the EC2 instance role for credentials.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
